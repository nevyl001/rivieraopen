# Copy to .env.local for local development:
#   cp .env.example .env.local

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Supabase (rankings públicos — multi-organizador vía vista oficial)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: solo scripts locales (verify-player-history.mjs). NO usado en /rankings ni /players.
# NEXT_PUBLIC_RANKING_ORGANIZADOR_ID=

# URL canónica del sitio (Passport / Open Graph). Ej: https://rivieraopen.com
# NEXT_PUBLIC_SITE_URL=

# Perfiles públicos /player/RIV-*: ejecutar una vez en Supabase SQL Editor:
#   supabase/get-public-jugador-id-for-riviera-id.sql
# (par de get_public_riviera_id_for_jugador, ya desplegado en 2.1.3B)

# Optional: contact form email (Resend — si no está, usa FormSubmit a rivieraopen@gmail.com)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=rivieraopen@gmail.com
# CONTACT_FROM_EMAIL=Riviera Open <rivieraopen@gmail.com>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
